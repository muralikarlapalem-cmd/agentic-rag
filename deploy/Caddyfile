# Caddy obtains and renews a Let's Encrypt certificate for {$DOMAIN} automatically.
# It also sets X-Forwarded-For to the real client address (used for rate limiting).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Streamlit needs WebSockets; reverse_proxy handles the upgrade transparently.
	reverse_proxy app:8501
}

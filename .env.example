# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Required on any hosted deployment (the setup script refuses to start without it)
APP_PASSWORD=choose-a-long-passphrase

# ── Optional ──────────────────────────────────────────────────────────────────
# Live web search. Without it the agent has Wikipedia + arXiv only.
TAVILY_API_KEY=tvly-...
# Public hostname for automatic HTTPS (the setup script can also set this via --domain)
DOMAIN=rag.example.com
# Cost control: questions allowed per client per hour
MAX_QUESTIONS_PER_HOUR=30

CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO
